# Local development Gemfile.
# Use with: BUNDLE_GEMFILE=Gemfile.dev bundle exec jekyll serve
#
# The production deploy uses `actions/jekyll-build-pages@v1` (which has
# its own preinstalled github-pages bundle) so this file does NOT affect
# what GitHub Pages renders. It exists purely for local preview.

source "https://rubygems.org"

gem "jekyll", "~> 4.4"
gem "webrick"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-paginate"
  gem "jekyll-gist"
  gem "jekyll-redirect-from"
end
